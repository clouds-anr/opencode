{
	"$schema": "https://opencode.ai/config.json",
	"provider": {
		"opencode": {
			"options": {}
		}
	},
	"permission": {
		"edit": {
			"packages/opencode/migration/*": "deny"
		}
	},
	"mcp": {},
	"tools": {
		"github-triage": false,
		"github-pr-search": false
	},
	// Agents live in .opencode/agent/ and .github/agents/ — skills live in .opencode/skills/
	// Use @ammo_team_lead as the main entry point for any task.
	"agent": {
		// ── Core agents ───────────────────────────────────────────────────────
		"ammo_team_lead": {
			"description": "AMMO Team Lead - coordinates all work, delegates to specialists",
			"mode": "primary",
			"model": "amazon-bedrock/anthropic.claude-sonnet-4-6",
			"prompt": "{file:agent/ammo_team_lead.md}"
		},
		"researcher": {
			"description": "Researcher + Planner - deep codebase analysis, actionable plans",
			"mode": "subagent",
			"model": "amazon-bedrock/anthropic.claude-haiku-4-5-20251001-v1:0",
			"prompt": "{file:agent/researcher.md}"
		},
		"implementor": {
			"description": "Implementor - features, fixes, and refactors across any language or domain",
			"mode": "subagent",
			"model": "amazon-bedrock/anthropic.claude-haiku-4-5-20251001-v1:0",
			"prompt": "{file:agent/implementor.md}"
		},
		"tester": {
			"description": "Tester - test design, execution, and regression validation",
			"mode": "subagent",
			"model": "amazon-bedrock/anthropic.claude-haiku-4-5-20251001-v1:0",
			"prompt": "{file:agent/tester.md}"
		},
		"documentation": {
			"description": "Documentation - PlantUML diagrams, ADRs, API docs, release notes",
			"mode": "subagent",
			"model": "amazon-bedrock/anthropic.claude-haiku-4-5-20251001-v1:0",
			"prompt": "{file:agent/documentation.md}"
		},
		// ANRCODE_CHANGE {"issue":321,"branch":"anr/321/create-anrcode-agentic-dev-team","date":"2026-07-06"}
		"anr_team_lead": {
			"description": "ANR Team Lead - coordinates all ANRCode work, delegates to ANR specialists",
			"mode": "primary",
			"model": "amazon-bedrock/anthropic.claude-sonnet-4-6",
			"prompt": "{file:../.github/agents/anr_team_lead.md}"
		},
		"anr_researcher": {
			"description": "ANR Researcher - ANRCode codebase analysis and implementation planning",
			"mode": "subagent",
			"model": "amazon-bedrock/anthropic.claude-haiku-4-5-20251001-v1:0",
			"prompt": "{file:../.github/agents/anr_researcher.md}"
		},
		"anr_implementor": {
			"description": "ANR Implementor - ANRCode changes, branch management, and PR creation",
			"mode": "subagent",
			"model": "amazon-bedrock/anthropic.claude-haiku-4-5-20251001-v1:0",
			"prompt": "{file:../.github/agents/anr_implementor.md}"
		},
		"anr_tester": {
			"description": "ANR Tester - validates ANRCode changes against opencode test conventions",
			"mode": "subagent",
			"model": "amazon-bedrock/anthropic.claude-haiku-4-5-20251001-v1:0",
			"prompt": "{file:../.github/agents/anr_tester.md}"
		},
		"anr_documentarian": {
			"description": "ANR Documentarian - enforces ANRCode documentation patterns and ADRs",
			"mode": "subagent",
			"model": "amazon-bedrock/anthropic.claude-haiku-4-5-20251001-v1:0",
			"prompt": "{file:../.github/agents/anr_documentarian.md}"
		},
		"anr_truth_teller": {
			"description": "ANR Truth-Teller - challenges risky ANRCode plans before implementation",
			"mode": "subagent",
			"model": "amazon-bedrock/anthropic.claude-sonnet-4-5-20250929-v1:0",
			"prompt": "{file:../.github/agents/anr_truth_teller.md}"
		},
		"truth_teller": {
			"description": "Truth-Teller (default) - challenges assumptions and risky plans",
			"mode": "subagent",
			"model": "amazon-bedrock/anthropic.claude-sonnet-4-5-20250929-v1:0",
			"prompt": "{file:agent/truth_teller.md}"
		},
		"truth_teller_sonnet": {
			"description": "Truth-Teller (Sonnet) - Claude Sonnet perspective",
			"mode": "subagent",
			"model": "amazon-bedrock/anthropic.claude-sonnet-4-5-20250929-v1:0",
			"prompt": "{file:agent/truth_teller.md}"
		},
		"truth_teller_nova": {
			"description": "Truth-Teller (Nova) - Amazon Nova perspective",
			"mode": "subagent",
			"model": "amazon-bedrock/amazon.nova-pro-v1:0",
			"prompt": "{file:agent/truth_teller.md}"
		},
		"truth_teller_lite": {
			"description": "Truth-Teller (Lite) - Amazon Nova Lite perspective",
			"mode": "subagent",
			"model": "amazon-bedrock/amazon.nova-lite-v1:0",
			"prompt": "{file:agent/truth_teller.md}"
		}
	}
}
