// ANRCODE_CHANGE {"issue":350,"branch":"fork-identify-agent-enforce","date":"2026-07-22"}
{
	"$schema": "https://opencode.ai/config.json",
	"provider": {
		"opencode": {
			"options": {}
		}
	},
	"permission": {
		"edit": {
			"packages/opencode/migration/*": "deny"
		}
	},
	"mcp": {},
	"tools": {
		"github-triage": false,
		"github-pr-search": false
	},
	// Agents live in .opencode/agent/ and .github/agents/ — skills live in .opencode/skills/
	// ANRCODE_CHANGE {"issue":383,"branch":"anr/383/move-ammo-to-aitemplates-doco","date":"2026-07-30"}
	// AMMO team moved to https://github.com/clouds-anr/AITemplates-Doco/tree/main/Agents/AmmoTeam
	"agent": {
		// ANRCODE_CHANGE {"issue":321,"branch":"anr/321/create-anrcode-agentic-dev-team","date":"2026-07-06"}
		"anr_team_lead": {
			"description": "ANR Team Lead - coordinates all ANRCode work, delegates to ANR specialists",
			"mode": "primary",
			"model": "amazon-bedrock/anthropic.claude-sonnet-4-6",
			"prompt": "{file:agent/anr_team_lead.md}"
		},
		"anr_researcher": {
			"description": "ANR Researcher - ANRCode codebase analysis and implementation planning",
			"mode": "subagent",
			"model": "amazon-bedrock/anthropic.claude-haiku-4-5-20251001-v1:0",
			"prompt": "{file:agent/anr_researcher.md}"
		},
		"anr_implementor": {
			"description": "ANR Implementor - ANRCode changes, branch management, and PR creation",
			"mode": "subagent",
			"model": "amazon-bedrock/anthropic.claude-haiku-4-5-20251001-v1:0",
			"prompt": "{file:agent/anr_implementor.md}"
		},
		"anr_tester": {
			"description": "ANR Tester - validates ANRCode changes against opencode test conventions",
			"mode": "subagent",
			"model": "amazon-bedrock/anthropic.claude-haiku-4-5-20251001-v1:0",
			"prompt": "{file:agent/anr_tester.md}"
		},
		"anr_documentarian": {
			"description": "ANR Documentarian - enforces ANRCode documentation patterns and ADRs",
			"mode": "subagent",
			"model": "amazon-bedrock/anthropic.claude-haiku-4-5-20251001-v1:0",
			"prompt": "{file:agent/anr_documentarian.md}"
		},
		"anr_truth_teller": {
			"description": "ANR Truth-Teller - challenges risky ANRCode plans before implementation",
			"mode": "subagent",
			"model": "amazon-bedrock/anthropic.claude-sonnet-4-5-20250929-v1:0",
			"prompt": "{file:agent/anr_truth_teller.md}"
		},
		"truth_teller": {
			"description": "Truth-Teller (default) - challenges assumptions and risky plans",
			"mode": "subagent",
			"model": "amazon-bedrock/anthropic.claude-sonnet-4-5-20250929-v1:0",
			"prompt": "{file:agent/truth_teller.md}"
		},
		"truth_teller_sonnet": {
			"description": "Truth-Teller (Sonnet) - Claude Sonnet perspective",
			"mode": "subagent",
			"model": "amazon-bedrock/anthropic.claude-sonnet-4-5-20250929-v1:0",
			"prompt": "{file:agent/truth_teller.md}"
		},
		"truth_teller_nova": {
			"description": "Truth-Teller (Nova) - Amazon Nova perspective",
			"mode": "subagent",
			"model": "amazon-bedrock/amazon.nova-pro-v1:0",
			"prompt": "{file:agent/truth_teller.md}"
		},
		"truth_teller_lite": {
			"description": "Truth-Teller (Lite) - Amazon Nova Lite perspective",
			"mode": "subagent",
			"model": "amazon-bedrock/amazon.nova-lite-v1:0",
			"prompt": "{file:agent/truth_teller.md}"
		}
	}
}
